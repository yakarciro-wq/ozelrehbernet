          type: "Soru-Cevap",
          date: "2021-11-18",
          summaryText: "Sol beyin yarımküresi dilsel kodlama, gramer, ardışık analiz ve dizisel işlemlerde uzmandır; sağ beyin yarımküresi ise görsel-uzamsal algı, örüntü kavrama ve bütünü görme süreçlerinde aktiftir."
        }
      ];

      const eventsData = [
        { id: 1, title: "Down Sendromlu Çocuklar İçin Sonbahar Şenliği", dateText: "5 Ekim 2026", location: "İstanbul", city: "İstanbul", category: "Şenlik", tag: "Açık Hava", thumbClass: "thumb-1", thumbText: "Açık Hava Şenliği" },
        { id: 2, title: "Otizm Spektrum Bozukluğunda Yeni Yaklaşımlar Semineri", dateText: "12 Ekim 2026", location: "Online", city: "Online", category: "Seminer", tag: "Online", thumbClass: "thumb-2", thumbText: "Seminer Oturumu" },
        { id: 3, title: "Engelsiz Tatil Programı: Antalya Deneyim Kampı", dateText: "20-24 Ekim 2026", location: "Antalya", city: "İzmir", category: "Tatil", tag: "Kamp", thumbClass: "thumb-3", thumbText: "Tatil Kampı" }
      ];

      const PAGE_SIZE = 6;
      let currentPage = 1;
      let activeFolder = "Tümü";
      let selectedDay = 5;

      function escapeRegExp(str) {
        return str.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
      }

      function highlightText(text, query) {
        if (!query) return text;
        const terms = query.trim().split(/\s+/).filter(t => t.length >= 2);
        if (terms.length === 0) return text;
        const pattern = new RegExp(`(${terms.map(escapeRegExp).join("|")})`, "gi");
        return text.replace(pattern, `<mark class="hl">$1</mark>`);
      }

      function goScreen(screenId) {
        document.querySelectorAll(".screen").forEach(el => el.classList.remove("active"));
        const target = document.getElementById("screen-" + screenId);
        if (target) target.classList.add("active");

        document.querySelectorAll(".nav-btn").forEach(btn => {
          btn.classList.toggle("active", btn.dataset.screen === screenId);
        });
        window.scrollTo({ top: 0, behavior: "smooth" });
      }

      function openDetailModal(item, query = "") {
        const modal = document.getElementById("detailModalOverlay");
        const titleEl = document.getElementById("modalTitle");
        const folderEl = document.getElementById("modalFolder");
        const bodyEl = document.getElementById("modalBody");

        if (!modal || !titleEl || !bodyEl) return;

        titleEl.innerHTML = highlightText(item.title, query);
        if (folderEl) folderEl.textContent = `📁 ${item.folder}`;

        bodyEl.innerHTML = `<p class="modal-paragraph">${highlightText(item.summaryText || item.excerpt, query)}</p>`;
        modal.classList.add("active");
      }

      function getFilteredSearchItems() {
        const pageInput = document.getElementById("pageSearchInput");
        const q = pageInput ? pageInput.value.trim().toLowerCase() : "";
        const cats = Array.from(document.querySelectorAll(".cat-check:checked")).map(c => c.value);
        const types = Array.from(document.querySelectorAll(".type-check:checked")).map(t => t.value);

        return knowledgeBase.filter(item => {
          const matchFolder = activeFolder === "Tümü" || item.folder === activeFolder;
          const matchQ = !q || item.title.toLowerCase().includes(q) || item.excerpt.toLowerCase().includes(q) || item.summaryText.toLowerCase().includes(q);
          const matchCat = cats.length === 0 || cats.includes(item.category);
          const matchType = types.length === 0 || types.includes(item.type);
          return matchFolder && matchQ && matchCat && matchType;
        });
      }

      function renderPagination(totalItems) {
        const bar = document.getElementById("paginationBar");
        if (!bar) return;
        const totalPages = Math.max(1, Math.ceil(totalItems / PAGE_SIZE));
        if (currentPage > totalPages) currentPage = totalPages;

        let html = "";
        for (let p = 1; p <= totalPages; p++) {
          html += `<button type="button" class="page-num ${p === currentPage ? "active" : ""}" data-page="${p}">${p}</button>`;
        }
        bar.innerHTML = html;

        bar.querySelectorAll(".page-num[data-page]").forEach(btn => {
          btn.addEventListener("click", () => {
            currentPage = Number(btn.dataset.page);
            renderSearchResults();
          });
        });
      }

      function renderSearchResults() {
        const pageInput = document.getElementById("pageSearchInput");
        const heading = document.getElementById("searchResultsHeading");
        const grid = document.getElementById("searchResultsGrid");

        if (!heading || !grid) return;

        const q = pageInput ? pageInput.value.trim() : "";
        const filtered = getFilteredSearchItems();
        heading.textContent = `Arama Sonuçları: ${filtered.length} kayıt bulundu`;

        if (filtered.length === 0) {
          grid.innerHTML = `<div class="result-card featured"><div class="result-title">Eşleşen kayıt bulunamadı</div><div class="result-excerpt">Filtreleri veya arama kelimesini değiştirerek arama yapabilirsiniz.</div></div>`;
          renderPagination(0);
          return;
        }

        const startIdx = (currentPage - 1) * PAGE_SIZE;
        const pageItems = filtered.slice(startIdx, startIdx + PAGE_SIZE);

        grid.innerHTML = pageItems.map(item => `
          <article class="result-card" data-id="${item.id}">
            <span class="badge-folder">📁 ${highlightText(item.folder, q)}</span>
            <div class="result-title">${highlightText(item.title, q)}</div>
            <p class="result-excerpt">${highlightText(item.excerpt, q)}</p>
            <div class="result-meta">
              <span>ÖzelRehberNET › ${item.category}</span>
              <span class="read-more-link">Detaylı Okuyun &rarr;</span>
            </div>
          </article>
        `).join("");

        renderPagination(filtered.length);

        grid.querySelectorAll(".result-card[data-id]").forEach(card => {
          card.addEventListener("click", () => {
            const id = Number(card.dataset.id);
            const item = knowledgeBase.find(i => i.id === id);
            if (item) openDetailModal(item, q);
          });
        });
      }

      function renderAllQA(filterTerm = "") {
        const container = document.getElementById("qaSectionsContainer");
        if (!container) return;

        const qLower = filterTerm.toLowerCase().trim();
        const sssQuestions = knowledgeBase.filter(i => i.folder === "Sık Sorulan Sorular (SSS)");

        const filtered = sssQuestions.filter(item => {
          return !qLower || item.title.toLowerCase().includes(qLower) || item.summaryText.toLowerCase().includes(qLower);
        });

        if (filtered.length === 0) {
          container.innerHTML = `<div style="text-align:center; padding:20px;">Aranan kelimede soru bulunamadı.</div>`;
          return;
        }

        container.innerHTML = `
          <div>
            <div class="qa-section-title">📂 Soru Kartları (${filtered.length} Soru)</div>
            <div class="qa-grid">
              ${filtered.map(item => `
                <div class="qa-card-btn" data-qid="${item.id}">
                  <div>
                    <div class="qa-card-text">${highlightText(item.title, filterTerm)}</div>
                  </div>
                  <div class="qa-card-footer">
                    <span>📁 SSS</span>
                    <span style="color:#1e4ed8; font-weight:700;">Yanıtı Aç &rarr;</span>
                  </div>
                </div>
              `).join("")}
            </div>
          </div>
        `;

        container.querySelectorAll(".qa-card-btn").forEach(btn => {
          btn.addEventListener("click", () => {
            const qid = Number(btn.dataset.qid);
            const found = knowledgeBase.find(x => x.id === qid);
            if (found) {
              const box = document.getElementById("assistantAnswerBox");
              const qLabel = document.getElementById("assistantQuestionLabel");
              const aText = document.getElementById("assistantAnswerText");
              qLabel.innerHTML = `📌 ${found.title}`;
              aText.innerHTML = `<p>${highlightText(found.summaryText, filterTerm)}</p>`;
              box.classList.add("active");
              box.scrollIntoView({ behavior: "smooth", block: "nearest" });
            }
          });
        });
      }

      function renderCalendar() {
        const grid = document.getElementById("calendarGrid");
        if (!grid) return;
        let html = `<div class="cal-day muted">28</div><div class="cal-day muted">29</div><div class="cal-day muted">30</div>`;
        for (let d = 1; d <= 31; d++) {
          const isSel = d === selectedDay ? "selected" : "";
          html += `<div class="cal-day ${isSel}"><span>${d}</span></div>`;
        }
        grid.innerHTML = html;
      }

      function renderEvents() {
        const list = document.getElementById("eventCardsList");
        if (!list) return;
        list.innerHTML = eventsData.map(ev => `
          <div class="event-card">
            <div class="event-thumb ${ev.thumbClass}">${ev.thumbText}</div>
            <div class="event-body">
              <div class="event-title">${ev.title}</div>
              <div class="event-meta">📍 ${ev.location} | 📅 ${ev.dateText}</div>
            </div>
          </div>
        `).join("");
      }

      function initApp() {
        document.querySelectorAll(".nav-btn").forEach(btn => {
          btn.addEventListener("click", () => goScreen(btn.dataset.screen));
        });

        document.querySelectorAll("[data-go]").forEach(btn => {
          btn.addEventListener("click", () => goScreen(btn.dataset.go));
        });

        const brandBtn = document.getElementById("brandHomeBtn");
        if (brandBtn) brandBtn.addEventListener("click", () => goScreen("home"));

        const heroForm = document.getElementById("heroSearchForm");
        if (heroForm) {
          heroForm.addEventListener("submit", (e) => {
            e.preventDefault();
            const heroInput = document.getElementById("heroSearchInput");
            const pageInput = document.getElementById("pageSearchInput");
            if (heroInput && pageInput) pageInput.value = heroInput.value.trim();
            currentPage = 1;
            goScreen("search");
            renderSearchResults();
          });
        }

        const homeFamiliesBtn = document.getElementById("homeFamiliesBtn");
        if (homeFamiliesBtn) homeFamiliesBtn.addEventListener("click", () => { goScreen("assistant"); renderAllQA("ÇÖZGER"); });

        const homeIndividualsBtn = document.getElementById("homeIndividualsBtn");
        if (homeIndividualsBtn) homeIndividualsBtn.addEventListener("click", () => { goScreen("assistant"); renderAllQA("BEP"); });

        const homeTeachersBtn = document.getElementById("homeTeachersBtn");
        if (homeTeachersBtn) homeTeachersBtn.addEventListener("click", () => { goScreen("assistant"); renderAllQA("VAKT"); });

        const pageSearchInput = document.getElementById("pageSearchInput");
        if (pageSearchInput) {
          pageSearchInput.addEventListener("input", () => {
            currentPage = 1;
            renderSearchResults();
          });
        }

        document.querySelectorAll(".folder-pill").forEach(pill => {
          pill.addEventListener("click", () => {
            activeFolder = pill.dataset.folder;
            currentPage = 1;
            document.querySelectorAll(".folder-pill").forEach(p => p.classList.remove("active"));
            pill.classList.add("active");
            renderSearchResults();
          });
        });

        const clearFiltersBtn = document.getElementById("clearFiltersBtn");
        if (clearFiltersBtn) {
          clearFiltersBtn.addEventListener("click", () => {
            if (pageSearchInput) pageSearchInput.value = "";
            activeFolder = "Tümü";
            currentPage = 1;
            document.querySelectorAll(".folder-pill").forEach(p => p.classList.toggle("active", p.dataset.folder === "Tümü"));
            document.querySelectorAll(".cat-check, .type-check").forEach(c => c.checked = false);
            renderSearchResults();
          });
        }

        document.querySelectorAll(".cat-check, .type-check").forEach(el => {
          el.addEventListener("change", () => {
            currentPage = 1;
            renderSearchResults();
          });
        });

        const assistantInput = document.getElementById("assistantInput");
        if (assistantInput) {
          assistantInput.addEventListener("input", () => renderAllQA(assistantInput.value));
        }

        const closeBtn = document.getElementById("modalCloseBtn");
        const closeFooterBtn = document.getElementById("modalCloseFooterBtn");
        const overlay = document.getElementById("detailModalOverlay");
        if (closeBtn) closeBtn.addEventListener("click", () => overlay.classList.remove("active"));
        if (closeFooterBtn) closeFooterBtn.addEventListener("click", () => overlay.classList.remove("active"));

        renderSearchResults();
        renderAllQA();
        renderCalendar();
        renderEvents();
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initApp);
      } else {
        initApp();
      }
    })();
  </script>
</body>
</html>
